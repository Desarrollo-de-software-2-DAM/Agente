# =================================================================
# Variables de entorno para Amershop — Agente IA Corporativo
# =================================================================
# Copia este archivo como .env:
#   Linux/macOS: cp .env.example .env
#   Windows CMD: copy .env.example .env
#   PowerShell:  Copy-Item .env.example .env

# --- Configuración General de la Tienda ---
STORE_NAME=Amershop

# --- Proveedor de LLM (Agente) ---
# "ollama": Agente 100% LOCAL, PRIVADO Y SIN TOKENS (Recomendado)
# "gemini": Proveedor en la nube vía Google AI Studio (requiere GOOGLE_API_KEY)
LLM_PROVIDER=ollama

# --- Configuración del Agente Local (Ollama - SIN TOKENS) ---
# OLLAMA_BASE_URL: En Docker Compose usa http://ollama:11434
# Si ejecutas Ollama en el host o externamente usa http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
# Modelos recomendados:
# - llama3.2       (3B parámetros, equilibrado y muy rápido)
# - llama3.2:1b    (1B parámetros, ultra liviano para VPS de 1GB/2GB RAM)
# - phi3:mini      (3.8B parámetros, alta precisión)
# - mistral        (7B parámetros, ideal para servidores con más de 8GB RAM o GPU)
OLLAMA_MODEL=llama3.2
OLLAMA_TEMPERATURE=0.1

# --- Configuración Opcional (Google Gemini - Solo si LLM_PROVIDER=gemini) ---
GOOGLE_API_KEY=
LLM_MODEL_AGENT=gemini-1.5-flash
LLM_MODEL_GRADER=gemini-1.5-flash

# --- Token opcional de Hugging Face (descarga embeddings públicos) ---
HF_TOKEN=

# --- Base de Datos Vectorial (FAISS en disco) ---
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=amershop_docs
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
SEARCH_K=8
DOCUMENTS_DIR=./documents

# --- Base de datos PostgreSQL ---
POSTGRES_USER=agente
POSTGRES_PASSWORD=cambia_esta_clave_segura
POSTGRES_DB=agente_db

# --- Contraseñas iniciales de usuarios corporativos ---
# Cámbialas para tu entorno de producción en la VPS
ADMIN_PASSWORD=amershop2024
USER1_PASSWORD=collab001
USER2_PASSWORD=collab002
RRHH_PASSWORD=recursosh01
VENTAS_PASSWORD=ventas2024
SOPORTE_PASSWORD=soporte01
